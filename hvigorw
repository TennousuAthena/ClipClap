#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
SELF_PATH="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"

resolve_path() {
  local target="$1"
  local dir
  local link

  while [[ -L "$target" ]]; do
    dir="$(cd "$(dirname "$target")" && pwd -P)"
    link="$(readlink "$target")"
    if [[ "$link" == /* ]]; then
      target="$link"
    else
      target="${dir}/${link}"
    fi
  done

  dir="$(cd "$(dirname "$target")" && pwd -P)"
  echo "${dir}/$(basename "$target")"
}

run_node_hvigor() {
  local script="$1"
  shift

  if [[ ! -r "$script" ]]; then
    return 1
  fi

  exec node -- "$script" "$@"
}

run_hvigor() {
  local candidate="$1"
  shift

  if [[ ! -x "$candidate" ]]; then
    return 1
  fi

  local candidate_path="$candidate"
  if [[ "$candidate" == */* ]]; then
    candidate_path="$(resolve_path "$candidate")"
  fi

  if [[ "$candidate_path" == "$SELF_PATH" ]]; then
    return 1
  fi

  if [[ "${CLIPCLAP_HVIGORW_ACTIVE:-}" == "1" && "$(basename "$candidate")" == "hvigorw" ]]; then
    return 1
  fi

  CLIPCLAP_HVIGORW_ACTIVE=1 exec "$candidate" "$@"
}

run_hvigor "${DEVECO_TOOLS_HOME:-}/hvigor/bin/hvigorw" "$@" || true

run_node_hvigor "${CMD_PATH:-}/bin/hvigorw.js" "$@" || true
run_node_hvigor "${CMD_PATH:-}/hvigor/bin/hvigorw.js" "$@" || true
run_node_hvigor "${CMD_PATH:-}/hvigor/hvigor/bin/hvigor.js" "$@" || true

if [[ -n "${CMD_PATH:-}" && -d "${CMD_PATH}" ]]; then
  while IFS= read -r script; do
    run_node_hvigor "$script" "$@" || true
  done < <(find "${CMD_PATH}" -type f \( -name hvigorw.js -o -name hvigor.js \) 2>/dev/null)
fi

run_hvigor "${CMD_PATH:-}/bin/hvigorw" "$@" || true
run_hvigor "${CMD_PATH:-}/bin/hvigor" "$@" || true
run_hvigor "${CMD_PATH:-}/hvigor/bin/hvigorw" "$@" || true
run_hvigor "${CMD_PATH:-}/hvigor/bin/hvigor" "$@" || true

if [[ -n "${CMD_PATH:-}" && -d "${CMD_PATH}" ]]; then
  while IFS= read -r candidate; do
    run_hvigor "$candidate" "$@" || true
  done < <(find "${CMD_PATH}" -type f \( -name hvigorw -o -name hvigor \) 2>/dev/null)
fi

hvigorw_path="$(command -v hvigorw || true)"
run_hvigor "$hvigorw_path" "$@" || true

hvigor_path="$(command -v hvigor || true)"
run_hvigor "$hvigor_path" "$@" || true

if [[ -x "/Applications/DevEco-Studio.app/Contents/tools/hvigor/bin/hvigorw" ]]; then
  if [[ -z "${DEVECO_SDK_HOME:-}" && -d "/Applications/DevEco-Studio.app/Contents/sdk" ]]; then
    export DEVECO_SDK_HOME="/Applications/DevEco-Studio.app/Contents/sdk"
  fi
  run_hvigor "/Applications/DevEco-Studio.app/Contents/tools/hvigor/bin/hvigorw" "$@" || true
fi

run_hvigor "${ROOT_DIR}/node_modules/.bin/hvigor" "$@" || true

echo "Unable to locate hvigorw. Install DevEco Studio or run through the CI setup action." >&2
exit 127
